# Copy this file to .env.sync and replace the placeholders.
# Never commit .env.sync or paste its secrets into chat.
WIREFRAME_REMOTE_URL=https://{project_name}-wireframe.stagingcloud.dev
WIREFRAME_SYNC_TOKEN=replace-with-the-worker-sync-secret
WIREFRAME_ACCESS_CLIENT_ID=replace-with-the-access-service-token-id
WIREFRAME_ACCESS_CLIENT_SECRET=replace-with-the-access-service-token-secret
